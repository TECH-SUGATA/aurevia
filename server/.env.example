PORT=3001
DB_FILE=./data/aurevia.db
# Set to 1 when running behind an HTTPS proxy (Caddy, Render, Fly, Nginx) so cookies are marked Secure.
TRUST_PROXY=0
# Optional: require this code to create an account (keeps strangers from using your AI credits).
INVITE_CODE=
# Optional: real leaf diagnosis and chat. Without it, safe demo answers are returned.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# AI requests allowed per user per day.
AI_DAILY_LIMIT=30
# Your GitHub repo as owner/name (e.g. sugata/aurevia). Used to show users the Pi install command.
GITHUB_REPO=
